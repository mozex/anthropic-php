{
    "name": "mozex/anthropic-php",
    "description": "PHP client for the Anthropic API: messages, streaming, tool use, thinking, web search, code execution, batches, and more.",
    "keywords": ["php", "anthropic", "claude", "sdk", "api", "client", "ai", "llm", "streaming", "tool-use", "thinking", "generative-ai", "text-generation", "claude-opus", "claude-sonnet", "claude-haiku", "mozex"],
    "homepage": "https://github.com/mozex/anthropic-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Mozex",
            "email": "hello@mozex.dev",
            "homepage": "https://mozex.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "php-http/discovery": "^1.20.0",
        "php-http/multipart-stream-builder": "^1.4.2",
        "psr/http-client": "^1.0.3",
        "psr/http-client-implementation": "^1.0.1",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1.0|^2.0.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.10.0",
        "guzzlehttp/psr7": "^2.8.0",
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "open-telemetry/api": "^1.10.1",
        "open-telemetry/context": "^1.5.0",
        "open-telemetry/sdk": "^1.15.0",
        "pestphp/pest": "^3.8.2|^4.0.0|^5.0.0",
        "pestphp/pest-plugin-type-coverage": "^3.5|^4.0.0|^5.0.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1.45",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "psr/log": "^3.0.2",
        "symfony/var-dumper": "^7.3.5"
    },
    "suggest": {
        "open-telemetry/api": "To trace each request with the OpenTelemetryMiddleware",
        "psr/log": "To log each request and response with Factory::withLogger()"
    },
    "autoload": {
        "psr-4": {
            "Anthropic\\": "src/"
        },
        "files": [
            "src/Anthropic.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "COV": "0.19.0"
    }
}
